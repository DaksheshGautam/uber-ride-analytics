              "expression": "let\n Source = Csv.Document(File.Contents(DataFolder & \"/bookings_clean.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),\n Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),\n Nulls = Table.ReplaceValue(Headers,\"\",null,Replacer.ReplaceValue,Table.ColumnNames(Headers)),\n Typed = Table.TransformColumnTypes(Nulls, {{\"booking_row_key\", Int64.Type},{\"booking_date\", type date},{\"booking_time\", type text},{\"booking_id\", type text},{\"status\", type text},{\"customer_id\", type text},{\"vehicle_type\", type text},{\"pickup\", type text},{\"dropoff\", type text},{\"avg_vtat\", type number},{\"avg_ctat\", type number},{\"customer_cancel_flag\", type number},{\"customer_cancel_reason\", type text},{\"driver_cancel_flag\", type number},{\"driver_cancel_reason\", type text},{\"incomplete_flag\", type number},{\"incomplete_reason\", type text},{\"booking_value\", type number},{\"ride_distance\", type number},{\"driver_rating\", type number},{\"customer_rating\", type number},{\"payment_method\", type text},{\"month\", type text},{\"hour\", Int64.Type},{\"weekday_number\", Int64.Type},{\"weekday\", type text},{\"is_weekend\", Int64.Type},{\"is_completed\", Int64.Type},{\"is_cancelled\", Int64.Type},{\"is_failed\", Int64.Type},{\"completed_value\", type number},{\"completed_distance\", type number},{\"failure_reason\", type text},{\"booking_id_reused\", Int64.Type},{\"vtat_band\", type text}}, \"en-US\")\nin Typed",
              "type": "m"
