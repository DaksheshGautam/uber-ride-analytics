        "lineageTag": "ae575a04-d3b8-414f-a0c4-d871c1f30ae5",
        "measures": [
          {
            "name": "Bookings",
            "description": "All source booking rows; row key is the analytical grain.",
            "displayFolder": "Operations KPIs",
            "expression": "COUNTROWS(Bookings)",
            "formatString": "#,0",
            "lineageTag": "1c452e31-7870-4a13-81af-642e63df8eef"
          },
          {
            "name": "Completed",
            "description": "Completed booking rows.",
            "displayFolder": "Operations KPIs",
            "expression": "CALCULATE([Bookings], KEEPFILTERS(Bookings[status] = \"Completed\"))",
            "formatString": "#,0",
            "lineageTag": "145f86c3-886d-4560-b95e-d641cde07e99"
          },
          {
            "name": "Completion Rate",
            "description": "Completed / booking rows in current filter context.",
            "displayFolder": "Operations KPIs",
            "expression": "DIVIDE([Completed], [Bookings])",
            "formatString": "0.0%",
            "lineageTag": "396aae96-2de5-40f4-ada2-8b31abf63869"
          },
          {
            "name": "Unsuccessful",
            "description": "Driver/customer cancellations + no-driver + incomplete.",
            "displayFolder": "Operations KPIs",
            "expression": "[Bookings] - [Completed]",
            "formatString": "#,0",
            "lineageTag": "b11d76b9-7d7e-483f-ba31-520c6bc43f21"
          },
          {
            "name": "Unsuccessful Rate",
            "description": "Unsuccessful / all selected booking rows.",
            "displayFolder": "Operations KPIs",
            "expression": "DIVIDE([Unsuccessful], [Bookings])",
            "formatString": "0.0%",
            "lineageTag": "3ac01f02-f7aa-4a13-adfb-fdd675b580b7"
          },
          {
            "name": "Cancellations",
            "description": "Driver and customer cancellations only.",
            "displayFolder": "Operations KPIs",
            "expression": "CALCULATE([Bookings], KEEPFILTERS(Bookings[is_cancelled] = 1))",
            "formatString": "#,0",
            "lineageTag": "696df71e-7fe0-4bbd-991f-5cac3c18df67"
          },
          {
            "name": "Cancellation Rate",
            "description": "Cancellations / all selected bookings.",
            "displayFolder": "Operations KPIs",
            "expression": "DIVIDE([Cancellations], [Bookings])",
            "formatString": "0.0%",
            "lineageTag": "9d55fbb2-7992-4002-9a14-acfb0217caea"
          },
          {
            "name": "Driver Cancellations",
            "description": "Driver-cancelled rows.",
            "displayFolder": "Operations KPIs",
            "expression": "CALCULATE([Bookings], KEEPFILTERS(Bookings[status] = \"Cancelled by Driver\"))",
            "formatString": "#,0",
            "lineageTag": "df4be938-6b0b-450e-9b46-51479882d7bd"
          },
          {
            "name": "No Driver",
            "description": "No-driver rows.",
            "displayFolder": "Operations KPIs",
            "expression": "CALCULATE([Bookings], KEEPFILTERS(Bookings[status] = \"No Driver Found\"))",
            "formatString": "#,0",
            "lineageTag": "0a63f9c3-7e8f-4926-8cbf-672653555cda"
          },
          {
            "name": "No Driver Rate",
            "description": "No-driver / all selected bookings.",
            "displayFolder": "Operations KPIs",
            "expression": "DIVIDE([No Driver], [Bookings])",
            "formatString": "0.0%",
            "lineageTag": "95135490-53ba-4e26-bb89-655d7ba195ce"
          },
          {
            "name": "Completed Booking Value",
            "description": "Recorded value of completed bookings; currency unspecified; not recognized revenue.",
            "displayFolder": "Operations KPIs",
            "expression": "SUM(Bookings[completed_value])",
            "formatString": "#,0",
            "lineageTag": "97e7b539-47ea-4f63-a54c-be8aa358e249"
          },
          {
            "name": "Avg Completed Value",
            "description": "Completed value / completed bookings.",
            "displayFolder": "Operations KPIs",
            "expression": "DIVIDE([Completed Booking Value], [Completed])",
            "formatString": "#,0.00",
            "lineageTag": "1801f22b-0518-470d-b727-b7becc21e6fa"
          },
          {
            "name": "Incomplete Recorded Value",
            "description": "Value recorded against incomplete rides; excluded from completed value.",
            "displayFolder": "Operations KPIs",
            "expression": "CALCULATE(SUM(Bookings[booking_value]), KEEPFILTERS(Bookings[status] = \"Incomplete\"))",
            "formatString": "#,0",
            "lineageTag": "7973d6fa-e478-4954-bb24-118a8fd75fa6"
          },
          {
            "name": "Avg Completed Distance",
            "description": "Source distance units are unverified.",
            "displayFolder": "Operations KPIs",
            "expression": "CALCULATE(AVERAGE(Bookings[ride_distance]), KEEPFILTERS(Bookings[status] = \"Completed\"))",
            "formatString": "0.00",
            "lineageTag": "f847120f-952e-40cf-8c2b-fe9a3c4c77d8"
          },
          {
            "name": "Avg Completed VTAT",
            "description": "Source VTAT definition and units are unverified.",
            "displayFolder": "Operations KPIs",
            "expression": "CALCULATE(AVERAGE(Bookings[avg_vtat]), KEEPFILTERS(Bookings[status] = \"Completed\"))",
            "formatString": "0.00",
            "lineageTag": "2086a57c-70b3-40fc-b155-d2ca445221af"
          },
          {
            "name": "Avg Completed CTAT",
            "description": "Source CTAT definition and units are unverified.",
            "displayFolder": "Operations KPIs",
            "expression": "CALCULATE(AVERAGE(Bookings[avg_ctat]), KEEPFILTERS(Bookings[status] = \"Completed\"))",
            "formatString": "0.00",
            "lineageTag": "06c1879e-6ced-4576-bab9-13a9ddfd2910"
          },
          {
            "name": "Driver Rating",
            "description": "Completed rides only; 1-5 rating scale.",
            "displayFolder": "Operations KPIs",
            "expression": "CALCULATE(AVERAGE(Bookings[driver_rating]), KEEPFILTERS(Bookings[status] = \"Completed\"))",
            "formatString": "0.00",
            "lineageTag": "3a22f06c-1fe4-44a5-8947-d4015ca0347a"
          },
          {
            "name": "Customer Rating",
            "description": "Completed rides only; survivor bias applies.",
            "displayFolder": "Operations KPIs",
            "expression": "CALCULATE(AVERAGE(Bookings[customer_rating]), KEEPFILTERS(Bookings[status] = \"Completed\"))",
            "formatString": "0.00",
            "lineageTag": "6e6d17cb-fe10-44a5-b5df-3375449a15d7"
          },
          {
            "name": "Distinct Booking IDs",
            "description": "Not the request count because IDs are reused.",
            "displayFolder": "Operations KPIs",
            "expression": "DISTINCTCOUNT(Bookings[booking_id])",
            "formatString": "#,0",
            "lineageTag": "0657fa8a-e769-4678-939d-cc92c355ba99"
          },
          {
            "name": "Excess ID Rows",
            "description": "Excess rows beyond distinct booking IDs in current context.",
            "displayFolder": "Operations KPIs",
            "expression": "[Bookings] - [Distinct Booking IDs]",
            "formatString": "#,0",
            "lineageTag": "6ff9c771-bf3b-4cd7-b70e-a9933c661545"
          },
          {
            "name": "Reused ID Rows",
            "description": "Rows whose ID is reused anywhere in the original extract.",
            "displayFolder": "Operations KPIs",
            "expression": "CALCULATE([Bookings], KEEPFILTERS(Bookings[booking_id_reused] = 1))",
            "formatString": "#,0",
            "lineageTag": "60801b22-bc7c-4d3a-89b4-e9afc9cc2933"
          },
          {
            "name": "Observed Days",
            "description": "Number of dates with booking rows after filters.",
            "displayFolder": "Operations KPIs",
            "expression": "DISTINCTCOUNT(Bookings[booking_date])",
            "formatString": "#,0",
            "lineageTag": "ca819d65-1f86-48b3-92da-dbcea0bb8244"
          },
          {
            "name": "Bookings per Observed Day",
            "description": "Normalizes different month lengths and weekday exposures.",
            "displayFolder": "Operations KPIs",
            "expression": "DIVIDE([Bookings], [Observed Days])",
            "formatString": "0.0",
            "lineageTag": "925434f5-6372-4aee-8f26-3f9972d3c8d4"
          },
          {
            "name": "Recovery Value 1pp",
            "description": "Illustrative +1 percentage point completion at selected completed average value; not a forecast.",
            "displayFolder": "Operations KPIs",
            "expression": "[Bookings] * 0.01 * [Avg Completed Value]",
            "formatString": "#,0",
            "lineageTag": "4647cccb-6b94-4cdb-a016-bd543eb82fb3"
          },
          {
            "name": "Rated Completed",
            "description": "Nonblank driver ratings; only completed rows have ratings.",
            "displayFolder": "Operations KPIs",
            "expression": "COUNT(Bookings[driver_rating])",
            "formatString": "#,0",
            "lineageTag": "dc74c559-6c43-40dc-bcfe-f52c1f935091"
          },
          {
            "name": "Failure Rows",
            "displayFolder": "Atlas / Editorial measures",
            "expression": "IF([Unsuccessful] > 0, [Unsuccessful])",
            "formatString": "#,0",
            "lineageTag": "cc9008d8-1248-4e8d-ba9c-20a776f93a5e"
          },
          {
            "name": "Driver Failure Share",
            "displayFolder": "Atlas / Editorial measures",
            "expression": "DIVIDE([Driver Cancellations], [Unsuccessful])",
            "formatString": "0.0%",
            "lineageTag": "2bd3ac51-6fe8-423d-92d1-569503681c5d"
          },
          {
            "name": "VTAT Observed",
            "displayFolder": "Atlas / Editorial measures",
            "expression": "COUNT(Bookings[avg_vtat])",
            "formatString": "#,0",
            "lineageTag": "b4a46a32-d06f-4163-bdfb-57b990261ab2"
          },
          {
            "name": "CTAT Observed",
            "displayFolder": "Atlas / Editorial measures",
            "expression": "COUNT(Bookings[avg_ctat])",
            "formatString": "#,0",
            "lineageTag": "f2041453-db1b-4415-83d4-b22dc413e331"
          },
          {
            "name": "Value Observed",
            "displayFolder": "Atlas / Editorial measures",
            "expression": "COUNT(Bookings[booking_value])",
            "formatString": "#,0",
            "lineageTag": "b7a7bcfe-9fe8-4b36-a39a-504e8f2587bc"
          },
          {
            "name": "Rating Observed",
            "displayFolder": "Atlas / Editorial measures",
            "expression": "COUNT(Bookings[driver_rating])",
            "formatString": "#,0",
            "lineageTag": "b22ad217-89af-461f-80f5-976d14fe8c45"
          },
          {
            "name": "Completed Value Millions",
            "displayFolder": "Atlas / Editorial measures",
            "expression": "DIVIDE([Completed Booking Value], 1000000)",
            "formatString": "0.00\"m\"",
            "lineageTag": "a99dbca4-47b4-4915-a5e5-c4c4b8b825e0"
          },
          {
            "name": "Peak Hour",
            "displayFolder": "Atlas / Editorial measures",
            "expression": "VAR h = TOPN(1, ADDCOLUMNS(VALUES(Bookings[hour]), \"n\", [Bookings]), [n], DESC, Bookings[hour], ASC) RETURN FORMAT(MAXX(h, Bookings[hour]), \"00\") & \":00\"",
            "lineageTag": "c06f11e6-7d02-46a6-8a72-fb5fd085c7a6"
          },
          {
            "name": "Peak Hour Requests",
            "displayFolder": "Atlas / Editorial measures",
            "expression": "MAXX(ADDCOLUMNS(VALUES(Bookings[hour]), \"n\", [Bookings]), [n])",
            "formatString": "#,0",
            "lineageTag": "b5641e1a-8f8a-4407-8575-b27d33914e73"
          },
          {
            "name": "Customer Cancellations",
            "displayFolder": "Atlas / Editorial measures",
            "expression": "CALCULATE([Bookings], KEEPFILTERS(Bookings[status]=\"Cancelled by Customer\"))",
            "formatString": "#,0",
            "lineageTag": "fa5c762a-5dd2-4f16-b461-c9bcbe1efdf6"
          }
        ],
